{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/HQs", "destination": "/hqs", "permanent": true },
    { "source": "/HQS", "destination": "/hqs", "permanent": true },
    { "source": "/Hqs", "destination": "/hqs", "permanent": true },
    { "source": "/hq", "destination": "/hqs", "permanent": true },
    { "source": "/quadrinhos", "destination": "/hqs", "permanent": true },
    { "source": "/Livros", "destination": "/livros", "permanent": true },
    { "source": "/LIVROS", "destination": "/livros", "permanent": true },
    { "source": "/livro", "destination": "/livros", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index-livros" },
    { "source": "/livros", "destination": "/index-livros" },
    { "source": "/hqs", "destination": "/index-hqs" },
    { "source": "/privacidade", "destination": "/privacidade" },
    { "source": "/termos", "destination": "/termos" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] },
    { "source": "/assets/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
    ] },
    { "source": "/", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] },
    { "source": "/livros", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] },
    { "source": "/hqs", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] },
    { "source": "/privacidade", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] },
    { "source": "/termos", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] }
  ]
}
